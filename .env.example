# TaskFlow — variables d'environnement (copier en .env et adapter)
# Documentation complète : .brain/11-ENVIRONNEMENT.md
# Ne JAMAIS committer le .env réel (INV-09).

# --- Base de données (docker compose + backend) ---
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
DB_HOST=localhost
DB_PORT=3306

# --- Backend ---
SERVER_PORT=8080
# L'URL JDBC est composée à partir de DB_HOST, DB_PORT et MYSQL_DATABASE ci-dessus.
# Générer une vraie valeur : openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Compte de démonstration créé au démarrage : camille.martin@taskflow.dev / Demo2026!
# Mettre false pour démarrer avec une base vide.
APP_DEMO_DATA=true
# Notifications : passage du générateur de rappels (ms) et fuseau du rappel de 17 h.
APP_NOTIFICATIONS_SCAN_INTERVAL_MS=30000
APP_TIMEZONE=Europe/Paris
# Récapitulatif quotidien par e-mail. En local, Mailpit capture les messages : les lire
# sur http://localhost:8025. En production, renseigner un vrai serveur SMTP ci-dessous.
APP_MAIL_ENABLED=true
APP_MAIL_DIGEST_HOUR=7
APP_MAIL_FROM=TaskFlow <no-reply@taskflow.local>
MAIL_HOST=mailpit
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
# Adresse publique de l'application, mise en lien dans les e-mails.
APP_PUBLIC_URL=http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Docker (docker compose up) ---
# Port de l'application complète : http://localhost:3000
WEB_PORT=3000
