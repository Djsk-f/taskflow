# TaskFlow — variables d'environnement (copier en .env et adapter)
# Documentation complète : .brain/11-ENVIRONNEMENT.md
# Ne JAMAIS committer le .env réel (INV-09).

# --- Base de données (docker compose + backend) ---
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
DB_HOST=localhost
DB_PORT=3306

# --- Backend ---
SERVER_PORT=8080
# L'URL JDBC est composée à partir de DB_HOST, DB_PORT et MYSQL_DATABASE ci-dessus.
# Générer une vraie valeur : openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
