# --- Production : copier en .env sur le serveur, puis remplir ---------------------------
# Rien de ce fichier n'est un secret d'exemple à conserver : tout est à remplacer.

# Nom de domaine pointant (enregistrement A/AAAA) vers ce serveur, et adresse pour
# les avis d'expiration du certificat HTTPS.
DOMAIN=taskflow.mondomaine.fr
TLS_EMAIL=moi@mondomaine.fr

# --- Base de données ---
MYSQL_ROOT_PASSWORD=à_générer
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=à_générer

# --- Sécurité ---
# openssl rand -base64 48
JWT_SECRET=à_générer
JWT_EXPIRATION_MS=86400000

# --- Application ---
APP_DEMO_DATA=false
APP_TIMEZONE=Europe/Paris
APP_NOTIFICATIONS_SCAN_INTERVAL_MS=30000

# --- E-mails (récapitulatif quotidien) ---
# Laisser APP_MAIL_ENABLED=false tant qu'aucun serveur d'envoi n'est disponible :
# l'application fonctionne à l'identique, seuls les e-mails sont muets.
APP_MAIL_ENABLED=false
APP_MAIL_DIGEST_HOUR=7
APP_MAIL_FROM=TaskFlow <no-reply@mondomaine.fr>
MAIL_HOST=smtp.mondomaine.fr
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
